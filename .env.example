# Local development configuration reference only. The Apps Script runtime is sandbox-fixed.
# Do not put credentials in source control.
INVESTEC_ENVIRONMENT=sandbox
INVESTEC_API_BASE_URL=https://openapisandbox.investec.com
INVESTEC_AUTH_BASE_URL=https://openapisandbox.investec.com
INVESTEC_REQUIRED_SCOPES=accounts,balances,transactions

INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=

# Apps Script does not load .env automatically. Enter these values through the
# credential modal; they are stored in Apps Script User Properties.
